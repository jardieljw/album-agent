# ==========================================
# CONFIGURAÇÃO DE AMBIENTE - NUVEM / LOCAL
# ==========================================

# Chave de API do Google Gemini (Essencial para IA na Nuvem sem GPU)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=""

# Segurança e Proteção por Senha (Opcional, mas RECOMENDADO na Nuvem)
# Se preenchido, o navegador solicitará usuário e senha ao abrir o app
AUTH_USERNAME="admin"
AUTH_PASSWORD=""

# Porta de execução da aplicação
PORT=8000

# Caso queira conectar a um Ollama externo/remoto (opcional)
OLLAMA_BASE_URL="http://localhost:11434"
